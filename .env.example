# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GITHUB_TOKEN: Personal Access Token with repo scope for automated git push
GITHUB_TOKEN="ghp_xxxx"

# Firebase Client Configuration (Public / Vite)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# Firebase Admin Configuration (Server-Side)
FIREBASE_PROJECT_ID="your-app-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-app-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT=""

# Security: Super Admin Bootstrap Secret (Required for /api/auth bootstrap-admin)
VITE_ADMIN_BOOTSTRAP_SECRET="your-secure-random-bootstrap-secret"
ADMIN_BOOTSTRAP_SECRET="your-secure-random-bootstrap-secret"
